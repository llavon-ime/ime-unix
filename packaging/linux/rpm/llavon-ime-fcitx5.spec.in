Name:           llavon-ime-fcitx5
Version:        @VERSION@
Release:        1%{?dist}
Summary:        Llavon IME frontend and local inference service for Fcitx5
License:        BSD-2-Clause AND MIT AND Apache-2.0 AND BSL-1.0 AND CC-BY-NC-4.0 AND CC-BY-SA-4.0
URL:            https://github.com/llavon-ime/ime-unix
BuildArch:      x86_64

Requires:       fcitx5
Requires:       at-spi2-core
Requires:       glib2
Requires:       glibc
Requires:       libgcc
Requires:       libstdc++
Requires:       vulkan-loader
Requires:       sqlite-libs
Requires:       xdg-utils
Requires:       curl
Requires:       tar
Requires:       coreutils
Requires:       qt6-qtbase-gui
Requires:       qt6-qtwayland
Recommends:     PackageKit
Recommends:     polkit
Provides:       bundled(brotli)
Provides:       bundled(cpp-httplib)
Provides:       bundled(ctre)
Provides:       bundled(ggml)
Provides:       bundled(llama-cpp)
Provides:       bundled(reflectcpp)
Provides:       bundled(utfcpp)
Provides:       bundled(yyjson)

%global debug_package %{nil}
%global _build_id_links none
# The package carries its own private shared libraries: the service bundles
# llama.cpp/ggml and refcount helpers under the llavon-ime directory, and the
# pinned LoRA Trainer bundles the .NET runtime's private libgomp. Fedora's ELF
# generator does not publish provides for them, so their requires would stay
# unsatisfied and dnf would refuse the package. Filter them instead: the
# libraries are loaded from the package's own directories.
%global __requires_exclude ^lib(ggml|llama|reflectcpp|gomp-98b21ff3).*[.]so.*$

%description
Llavon IME provides local llama.cpp-based text prediction for Fcitx5. This
package includes the inference model, portable CPU backends, Vulkan backend,
and AT-SPI integration for reading context from the focused application.

%prep

%build

%install
mkdir -p %{buildroot}
cp -a %{_sourcedir}/pkgroot/. %{buildroot}/

%files
@PRIVATE_LIBDIR@/llavon-ime
%{_libdir}/fcitx5/llavon-ime-addon.so
%{_datadir}/fcitx5/addon/llavon-ime.conf
%{_datadir}/fcitx5/inputmethod/llavon-ime.conf
%{_datadir}/llavon-ime
%{_datadir}/applications/llavon-ime-lora.desktop
%{_datadir}/pixmaps/llavon-ime.png
%license %{_licensedir}/llavon-ime/mixed-lexicon-attribution.md
%{_licensedir}/llavon-ime-fcitx5

%changelog
* Tue Sep 15 2026 llavon-ime contributors <noreply@github.com> - @VERSION@-1
- Automated release build
